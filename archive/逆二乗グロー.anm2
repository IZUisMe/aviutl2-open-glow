--information:逆二乗グロー v1.0 (Deep Glow風・物理減衰ブルーム)
--label:発光
--filter
--track@strength:強さ,0,1000,100,0.1
--track@radius:拡散,4,2000,300,1
--track@falloff:減衰,0.5,4,2,0.01
--track@threshold:しきい値,0,100,0,0.1
--track@gamma_v:ガンマ,1,3,2.2,0.01
--select@blend_mode:合成モード=0,リニア加算=0,スクリーン=1,グローのみ=2
--color@tint:光色,nil
--check@fixsize:サイズ固定,false

--[[pixelshader@DG_Pre:
// 前処理: ガンマ補正でリニア光に変換し、しきい値カット(ソフトニー)と光色を適用
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float th_lin, knee, gam, tint_r;
    float tint_g, tint_b, pad0, pad1;
};
float4 DG_Pre(float4 pos : SV_Position) : SV_Target {
    float4 c = src.Load(int3(pos.xy, 0));
    float3 e = pow(max(c.rgb, 0.0), gam);
    float br = max(e.r, max(e.g, e.b));
    float soft = clamp(br - th_lin + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 1e-5);
    float contrib = max(soft, br - th_lin) / max(br, 1e-5);
    e *= contrib * float3(tint_r, tint_g, tint_b);
    return float4(e, c.a * contrib);
}
]]

--[[pixelshader@DG_Down:
// 1/2縮小 (13タップ・Jimenezフィルタ: ちらつき防止の定番)
Texture2D src : register(t0);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 t;
};
float4 DG_Down(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 s = 0.125 * src.SampleLevel(smp, uv, 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2(-1.0, -1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2( 1.0, -1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2(-1.0,  1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2( 1.0,  1.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 0.0, -2.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2(-2.0,  0.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 2.0,  0.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 0.0,  2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2(-2.0, -2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2( 2.0, -2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2(-2.0,  2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2( 2.0,  2.0), 0);
    return s;
}
]]

--[[pixelshader@DG_Up:
// テント補間で拡大した下位レベルを重みwlowで現レベルに累積
Texture2D low : register(t0);
Texture2D cur : register(t1);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 t;
    float wlow, pad0;
};
float4 DG_Up(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 s = 4.0 * low.SampleLevel(smp, uv, 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2(-1.0,  0.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 1.0,  0.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 0.0, -1.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 0.0,  1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2(-1.0, -1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2( 1.0, -1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2(-1.0,  1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2( 1.0,  1.0), 0);
    return cur.Load(int3(pos.xy, 0)) + wlow * (s / 16.0);
}
]]

--[[pixelshader@DG_Final:
// 合成: リニア空間で光を加算してガンマ空間へ戻す
Texture2D src : register(t0);
Texture2D glw : register(t1);
cbuffer constant0 : register(b0) {
    float amp, inv_gam, gam, mode;
};
float4 DG_Final(float4 pos : SV_Position) : SV_Target {
    float4 c = src.Load(int3(pos.xy, 0));
    float3 g_lin = max(amp * glw.Load(int3(pos.xy, 0)).rgb, 0.0);
    float3 g_enc = pow(g_lin, inv_gam);
    float ah = saturate(max(g_enc.r, max(g_enc.g, g_enc.b)));
    if (mode > 1.5) {
        return float4(min(g_enc, 1.0), ah);  // グローのみ
    }
    float a_out = c.a + (1.0 - c.a) * ah;
    float3 rgb;
    if (mode < 0.5) {
        rgb = pow(pow(max(c.rgb, 0.0), gam) + g_lin, inv_gam);  // リニア加算
    } else {
        rgb = c.rgb + min(g_enc, 1.0) * (1.0 - min(c.rgb, 1.0));  // スクリーン
    }
    return float4(rgb, a_out);
}
]]

local obj, math = obj, math

-- パラメータ正規化
local I = strength / 100
local R = math.max(radius, 4)
local gam = gamma_v
if I <= 0 or obj.w < 1 or obj.h < 1 then return end

-- 光色 (リニア空間の係数に変換)
local tr, tg, tb = 1.0, 1.0, 1.0
if tint then
    local r8, g8, b8 = RGB(tint)
    tr = (r8 / 255) ^ gam
    tg = (g8 / 255) ^ gam
    tb = (b8 / 255) ^ gam
end

-- グローがはみ出す領域を確保 (フィルタオブジェクト時とサイズ固定時は拡張しない)
if not (obj.getinfo("filter") or fixsize) then
    local maxw, maxh = obj.getinfo("image_max")
    local pad = math.floor(math.min(R * 1.25, (maxw - obj.w) / 2, (maxh - obj.h) / 2))
    if pad > 0 then
        obj.effect("領域拡張", "上", pad, "下", pad, "左", pad, "右", pad, "塗りつぶし", 0)
    end
end

local w, h = obj.w, obj.h

-- ピラミッドの段数: 拡散半径Rに対して log2(R) 段 (端数は最上段の重みで補間)
-- 重み比 q = 2^(2-p): 1オクターブごとに重みq倍 → 合成PSFの裾が r^(-p) に漸近
--   p=2 (q=1, 等重み) がちょうど逆二乗則
local p = falloff
local q = 2 ^ (2 - p)
local nf = math.log(R) / math.log(2)
local n_full = math.min(math.floor(nf), 12)
local frac = nf - n_full
local M = math.min(n_full + (frac > 0 and 1 or 0), 12)

-- 各レベルのサイズ (小さくなりすぎたら打ち切り)
local lw, lh = { [0] = w }, { [0] = h }
local Meff = 0
for k = 1, M do
    if math.max(lw[k - 1], lh[k - 1]) <= 2 then break end
    lw[k] = math.max(1, math.ceil(lw[k - 1] / 2))
    lh[k] = math.max(1, math.ceil(lh[k - 1] / 2))
    Meff = k
end
M = math.min(M, Meff)
if M < 1 then return end
local partial = frac > 0 and M == n_full + 1

-- 正規化係数 (実際に使うレベルの重みの総和)
local total, coeff = 1.0, 1.0
for k = 1, M do
    coeff = coeff * q
    total = total + (partial and k == M and coeff * frac or coeff)
end

local buf = {}
for k = 0, M do buf[k] = "cache:invsq_glow/" .. k end

-- [1] 前処理: リニア化 + しきい値 + 光色 → レベル0
local t_lin = (threshold / 100) ^ gam
obj.clearbuffer(buf[0], w, h)
obj.pixelshader("DG_Pre", buf[0], "object", { t_lin, 0.5 * t_lin, gam, tr, tg, tb, 0, 0 })

-- [2] ダウンサンプル・チェーン
for k = 1, M do
    obj.clearbuffer(buf[k], lw[k], lh[k])
    obj.pixelshader("DG_Down", buf[k], buf[k - 1], { 1 / lw[k - 1], 1 / lh[k - 1] }, "copy", "clip")
end

-- [3] アップサンプルしながら重み付き累積 (最深段→レベル0)
for k = M - 1, 0, -1 do
    local wl = (partial and k == M - 1) and q * frac or q
    obj.pixelshader("DG_Up", buf[k], { buf[k + 1], buf[k] },
        { 1 / lw[k + 1], 1 / lh[k + 1], wl, 0 }, "copy", "clip")
end

-- [4] 合成
obj.pixelshader("DG_Final", "object", { "object", buf[0] },
    { I / total, 1 / gam, gam, blend_mode })
